{
  "log": {
    "level": "warn",
    "output": "/var/log/sing-box/server.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-upstream",
        "address": "https://1.1.1.1/dns-query",
        "address_strategy": "prefer_ipv4",
        "strategy": "prefer_ipv4",
        "detour": "direct-out"
      },
      {
        "tag": "dns-block",
        "address": "rcode://success"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "geosite-category-ads-all"
        ],
        "server": "dns-block",
        "disable_cache": true
      }
    ],
    "final": "dns-upstream",
    "independent_cache": true
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "user1",
          "uuid": "YOUR_UUID",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "YOUR_DOMAIN",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "www.microsoft.com",
            "server_port": 443
          },
          "private_key": "YOUR_PRIVATE_KEY",
          "short_id": [
            "YOUR_SHORT_ID"
          ],
          "max_time_difference": "1m"
        },
        "alpn": [
          "h2",
          "http/1.1"
        ],
        "min_version": "1.3",
        "max_version": "1.3"
      },
      "multiplex": {
        "enabled": true,
        "protocol": "h2mux",
        "max_connections": 100,
        "min_streams": 4,
        "max_streams": 0,
        "padding": true,
        "brutal": {
          "enabled": true,
          "up_mbps": 1000,
          "down_mbps": 1000
        }
      },
      "packet_encoding": "xudp",
      "sniff": true,
      "sniff_override_destination": true,
      "sniff_timeout": "300ms"
    },
    {
      "type": "shadowsocks",
      "tag": "ss-in",
      "listen": "::",
      "listen_port": 8388,
      "method": "2022-blake3-aes-128-gcm",
      "password": "YOUR_SS_PASSWORD",
      "multiplex": {
        "enabled": true,
        "protocol": "h2mux",
        "max_connections": 100,
        "min_streams": 4,
        "max_streams": 0,
        "padding": true
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-out",
      "bind_interface": "eth0",
      "inet4_bind_address": "",
      "inet6_bind_address": "",
      "routing_mark": 255,
      "reuse_addr": true,
      "connect_timeout": "5s",
      "tcp_fast_open": true,
      "tcp_multi_path": true,
      "udp_fragment": true
    },
    {
      "type": "block",
      "tag": "block-out"
    },
    {
      "type": "dns",
      "tag": "dns-out"
    }
  ],
  "route": {
    "rules": [
      {
        "protocol": "dns",
        "outbound": "dns-out"
      },
      {
        "ip_is_private": true,
        "outbound": "block-out"
      },
      {
        "rule_set": [
          "geosite-category-ads-all"
        ],
        "outbound": "block-out"
      },
      {
        "rule_set": [
          "geoip-cn"
        ],
        "outbound": "direct-out"
      }
    ],
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "download_detour": "direct-out",
        "update_interval": "7d"
      },
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ads-all.srs",
        "download_detour": "direct-out",
        "update_interval": "7d"
      }
    ],
    "final": "direct-out",
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/var/lib/sing-box/cache.db",
      "store_fakeip": true,
      "store_rdrc": true,
      "rdrc_timeout": "7d"
    }
  }
}
